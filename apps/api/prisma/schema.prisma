// 우리 언제? — 데이터 모델 (기획서 23장 기준)
// 도메인 규칙: docs/domain.md / plan/whenwe_plan_v0.3.pdf

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Prisma 7: 연결 URL은 schema가 아니라 prisma.config.ts 에서 관리한다.
}

// ── Enums (값은 @whenwe/types 와 일치) ──────────────────────────

enum MeetingCategory {
  FRIEND
  STUDY
  BUSINESS
}

enum MeetingStatus {
  DRAFT
  COLLECTING
  READY_TO_CONFIRM
  CONFIRMED
  CLOSED
}

enum ParticipantType {
  MEMBER
  GUEST
}

enum AvailabilityStatus {
  AVAILABLE
  MAYBE
  UNAVAILABLE
}

// ── Models ─────────────────────────────────────────────────────

model User {
  id                Int       @id @default(autoincrement())
  email             String    @unique
  password          String
  nickname          String
  passwordChangedAt DateTime? @map("password_changed_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  ownedMeetings       Meeting[]            @relation("MeetingOwner")
  participations      Participant[]
  passwordResetTokens PasswordResetToken[]

  @@map("users")
}

model PasswordResetToken {
  id        Int       @id @default(autoincrement())
  userId    Int       @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

model Meeting {
  id                   Int             @id @default(autoincrement())
  ownerId              Int             @map("owner_id")
  title                String
  description          String?
  category             MeetingCategory
  status               MeetingStatus   @default(DRAFT)
  startDate            DateTime        @map("start_date") @db.Date
  endDate              DateTime        @map("end_date") @db.Date
  availableStartTime   String          @map("available_start_time") // "HH:mm"
  availableEndTime     String          @map("available_end_time") //   "HH:mm"
  durationHours        Int             @map("duration_hours")
  responseDeadline     DateTime        @map("response_deadline")
  inviteToken          String          @unique @map("invite_token")
  inviteTokenExpiresAt DateTime?       @map("invite_token_expires_at")
  confirmedStartAt     DateTime?       @map("confirmed_start_at")
  confirmedEndAt       DateTime?       @map("confirmed_end_at")
  createdAt            DateTime        @default(now()) @map("created_at")
  updatedAt            DateTime        @updatedAt @map("updated_at")

  owner           User                      @relation("MeetingOwner", fields: [ownerId], references: [id])
  participants    Participant[]
  slots           AvailabilitySlot[]
  availabilities  ParticipantAvailability[]
  recommendations RecommendationResult[]
  stateLogs       MeetingStateLog[]

  @@index([ownerId])
  @@index([status, responseDeadline]) // 스케줄러 조회용
  @@map("meetings")
}

model Participant {
  id              Int             @id @default(autoincrement())
  meetingId       Int             @map("meeting_id")
  userId          Int?            @map("user_id") // 비회원이면 null
  guestName       String          @map("guest_name")
  participantType ParticipantType @map("participant_type")
  editToken       String?         @unique @map("edit_token") // 비회원 응답 수정용
  // 참여 PIN 재접속(신규 비회원부터) — 회원/레거시 비회원은 null.
  normalizedGuestName String?   @map("normalized_guest_name")
  pinHash             String?   @map("pin_hash")
  pinFailedAttempts   Int       @default(0) @map("pin_failed_attempts")
  pinLockedUntil      DateTime? @map("pin_locked_until")
  isRequired      Boolean         @default(false) @map("is_required")
  createdAt       DateTime        @default(now()) @map("created_at")

  meeting        Meeting                   @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  // 회원 탈퇴 시 이 참여자·응답은 유지하되 회원 연결만 끊는다(userId → null).
  user           User?                     @relation(fields: [userId], references: [id], onDelete: SetNull)
  availabilities ParticipantAvailability[]

  // 회원(userId 존재)은 한 모임에 한 번만 — 비회원(userId null)은 Postgres 가 NULL 을
  // 유니크로 묶지 않아 기존처럼 중복 참여(동일 닉네임 포함)가 허용된다.
  @@unique([userId, meetingId])
  // 참여 PIN 재접속: 모임 내 정규화 닉네임 유일(신규 비회원부터). null 은 서로 다른 값으로
  // 취급되므로 레거시 비회원(normalizedGuestName=null)·회원은 이 제약에 걸리지 않는다.
  @@unique([meetingId, normalizedGuestName])
  @@index([meetingId])
  @@map("participants")
}

model AvailabilitySlot {
  id          Int      @id @default(autoincrement())
  meetingId   Int      @map("meeting_id")
  slotStartAt DateTime @map("slot_start_at")
  slotEndAt   DateTime @map("slot_end_at")
  createdAt   DateTime @default(now()) @map("created_at")

  meeting        Meeting                   @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  availabilities ParticipantAvailability[]

  @@unique([meetingId, slotStartAt]) // 슬롯 중복 방지
  @@index([meetingId, slotStartAt])
  @@map("availability_slots")
}

model ParticipantAvailability {
  id                 Int                @id @default(autoincrement())
  meetingId          Int                @map("meeting_id")
  participantId      Int                @map("participant_id")
  slotId             Int                @map("slot_id")
  availabilityStatus AvailabilityStatus @map("availability_status")
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")

  meeting     Meeting          @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  participant Participant      @relation(fields: [participantId], references: [id], onDelete: Cascade)
  slot        AvailabilitySlot @relation(fields: [slotId], references: [id], onDelete: Cascade)

  @@unique([participantId, slotId]) // 같은 참여자·슬롯 재제출은 update
  @@index([meetingId])
  @@map("participant_availability")
}

model RecommendationResult {
  id                       Int      @id @default(autoincrement())
  meetingId                Int      @map("meeting_id")
  rank                     Int
  startAt                  DateTime @map("start_at")
  endAt                    DateTime @map("end_at")
  availableCount           Int      @map("available_count")
  maybeCount               Int      @map("maybe_count")
  unavailableCount         Int      @map("unavailable_count")
  requiredAvailableCount   Int      @map("required_available_count")
  requiredMaybeCount       Int      @map("required_maybe_count")
  requiredUnavailableCount Int      @map("required_unavailable_count")
  // 필수참여자 전원 가능 여부 — 엔진이 재계산 시점에 산출해 저장(읽을 때 파생하지 않음)
  requiredParticipantSatisfied Boolean @default(false) @map("required_participant_satisfied")
  score                    Int // 가능 슬롯 점수 '합' (가능2/애매1/불가0). 평균 정렬의 대용(동일 N·동일 참여자 → 합 정렬 = 평균 정렬)
  createdAt                DateTime @default(now()) @map("created_at")

  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  @@unique([meetingId, rank])
  @@index([meetingId, rank])
  @@map("recommendation_results")
}

model MeetingStateLog {
  id             Int            @id @default(autoincrement())
  meetingId      Int            @map("meeting_id")
  previousStatus MeetingStatus? @map("previous_status")
  nextStatus     MeetingStatus  @map("next_status")
  reason         String?
  createdAt      DateTime       @default(now()) @map("created_at")

  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  @@index([meetingId])
  @@map("meeting_state_logs")
}
