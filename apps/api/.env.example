# ── 로컬 개발 / 운영(Railway) 공통 — .env 로 복사 후 환경에 맞게 채움 ──

# PostgreSQL 연결 문자열.
#  - 로컬: brew PostgreSQL  예) postgresql://postgres:postgres@localhost:5432/whenwe?schema=public
#  - 운영(Neon): 대시보드의 connection string. SSL 필수(sslmode=require 포함).
#    상시 가동 서버(Railway)이므로 'pooled'가 아닌 '직접(direct)' 연결 문자열 권장.
#    예) postgresql://USER:PASS@ep-xxx.ap-southeast-1.aws.neon.tech/whenwe?sslmode=require
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/whenwe?schema=public"

# JWT 서명 시크릿 (충분히 길고 예측 불가능한 임의 문자열. 하드코딩 금지, 미설정 시 부팅 실패)
JWT_SECRET=

# 프론트엔드 기준 URL (모임 생성 시 inviteUrl, 비밀번호 재설정 링크 구성에 사용)
#  - 운영: Vercel 도메인  예) https://woori-eonje.vercel.app
WEB_BASE_URL=http://localhost:3000

# CORS 허용 오리진 (쉼표로 여러 개). 미설정 시 http://localhost:3000.
#  - 운영: Vercel 도메인  예) https://woori-eonje.vercel.app,https://woori-eonje-*.vercel.app
CORS_ORIGIN=http://localhost:3000

# PORT 는 Railway 가 자동 주입. 로컬 미설정 시 3001.
# PORT=3001

# Resend(이메일 발송) API 키. 비밀번호 재설정 메일 발송에 사용. 미설정 시 부팅 실패.
#  - resend.com 대시보드 → API Keys 에서 발급(권한은 발송 전용으로 최소화 권장).
RESEND_API_KEY=

# 비밀번호 재설정 메일의 발신자 주소. Resend 에서 도메인 인증(SPF/DKIM)이 끝난 도메인이어야 한다.
#  - 미설정 시 noreply@woori-eonje.app 로 폴백.
MAIL_FROM=noreply@woori-eonje.app
