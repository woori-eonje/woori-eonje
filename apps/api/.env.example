# PostgreSQL 연결 문자열 (로컬/배포 환경에 맞게 .env 로 복사 후 수정)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/whenwe?schema=public"

# JWT 서명 시크릿 (충분히 길고 예측 불가능한 임의 문자열로 설정. 하드코딩 금지)
JWT_SECRET=

# 프론트엔드 기준 URL (모임 생성 시 inviteUrl 구성에 사용. 미설정 시 http://localhost:3000)
WEB_BASE_URL=http://localhost:3000
